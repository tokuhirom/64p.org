<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>[% title %] - Notes - 64p.org</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/static/notes.css">
    <link rel="alternate" type="application/rss+xml" title="Notes - 64p.org" href="/notes/rss.xml">
    <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/highlight.js@11/styles/github.min.css" media="(prefers-color-scheme: light)">
    <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/highlight.js@11/styles/github-dark.min.css" media="(prefers-color-scheme: dark)">
</head>
<body>
    <div class="notes-layout">
[% INCLUDE "notes-sidebar.tt" %]
        <main class="notes-main">
            <article class="notes-content">
                [% body | raw %]
                [% IF has_backlinks -%]
                <div class="notes-backlinks">
                    <h2>🔗 リンクされているノート</h2>
                    <ul>
                    [% FOR bl IN backlinks -%]
                        <li><a href="[% bl.link %]">[% bl.title %]</a></li>
                    [% END %]
                    </ul>
                </div>
                [% END -%]
                <div class="notes-meta">
                    <span>作成日時: [% created %] / 更新日時: [% updated %]</span>
                    <a class="share-x" href="https://twitter.com/intent/tweet?text=[% title | uri %]&url=[% url | uri %]" target="_blank" rel="noopener">𝕏 で共有</a>
                </div>
            </article>
            <footer class="notes-footer">
                <a href="https://github.com/tokuhirom">tokuhirom</a> による調査メモです。
                個人的な調査メモであり、正確な記述に努めていますが正確性を保証するものではなく、所属する団体を代表する見解でもありません。
            </footer>
        </main>
    </div>
    <script src="//cdn.jsdelivr.net/npm/highlight.js@11/lib/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
    <script src="/static/notes.js"></script>
[%- IF has_tweet_embed %]
    <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
    [%- END %]
[%- IF has_mermaid %]
    <script type="module">
    import mermaid from '//cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
    var root = document.documentElement;
    var divs = document.querySelectorAll('div.mermaid');
    divs.forEach(function (d) { d.dataset.src = d.textContent; });
    function isDark() {
        var t = root.getAttribute('data-theme');
        return t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
    }
    function render() {
        mermaid.initialize({ startOnLoad: false, theme: isDark() ? 'dark' : 'default' });
        divs.forEach(function (d) {
            d.textContent = d.dataset.src;
            d.removeAttribute('data-processed');
        });
        mermaid.run({ nodes: divs });
    }
    new MutationObserver(render).observe(root, { attributeFilter: ['data-theme'] });
    render();
    </script>
    [%- END %]
</body>
</html>
